# NAS-Zugang – kann auch über das Formular in der App eingetragen werden.
# Diese Datei wird von der App gelesen; die echte .env ist im .gitignore.

# Host/IP des NAS
NAS_HOST=

# Freigabe (Share), z. B. "3D-Print"
NAS_SHARE=

# Benutzer
NAS_USER=

# Domain (nur für Windows/AD-Shares, z. B. CORP; bei NAS meist leer)
NAS_DOMAIN=

# Passwort (leer lassen, falls in config.json gespeichert)
NAS_PASS=

# Ordner im Share, den gescannt werden soll
NAS_PATH=/

# SMB-Port
NAS_PORT=445

# Such-Tiefe: 0 = nur die direkte Ebene; >0 = rekursiv so viele Ebenen
MAX_DEPTH=0

# Port des Backends
PORT=4000
